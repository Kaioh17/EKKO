# API keys, the only thing ekko keeps in .env.
# Easiest: paste them in the app (Settings > Models > API keys), which writes
# this file for you. By hand: copy this file to .env in the data folder (the
# repo root in dev; %APPDATA%\io.usemaison.ekko on an installed Windows app).
# .env is gitignored, so real keys never get committed.
#
# Every other setting (provider, failover order, budgets, TTS engine, OS,
# thresholds) lives in the app's settings database; edit it in the app or
# through /api/settings/<section>.
# The API token is generated fresh on every launch; never put it here.

# Gemini. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# DeepSeek, pay-as-you-go: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Claude API, pay-as-you-go: https://console.anthropic.com/settings/keys
# (claude_code uses the `claude` CLI login instead, no key here.)
ANTHROPIC_API_KEY=

# OpenAI, pay-as-you-go (LLM and optional TTS): https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Optional, only for the private control_center/ tools (not in the public repo) ---
# EKKO_HOME_DIR=          # file-gateway root; unset = your home folder
# EKKO_LLM=ollama         # file-request parser: ollama | gemini | claude-cli
# EKKO_OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M
# OLLAMA_HOST=http://localhost:11434
# EKKO_CLAUDE_MODEL=haiku
