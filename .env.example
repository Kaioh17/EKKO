# Copy this file to .env (project root) and fill in your own keys.
# .env is gitignored -- real secrets never get committed.

# Gemini fallback LLM. Get a free key at https://aistudio.google.com/apikey
# -- no billing account required for the free tier.
GEMINI_API_KEY=

# Which scripts/<os>/ tree routing/host.py resolves handlers from:
# windows, linux, mac, or auto (detect via platform.system()). mac has no
# scripts/mac/ tree yet -- setting this to mac fails loudly at config load.
EKKO_OS=auto

# Where scripts/ekko_ui.py mirrors terminal report windows (daily_briefing,
# render_report) so ekko-ui can show them too. Defaults to the backend's
# usual local address; only set this if backend/main.py runs elsewhere.
EKKO_UI_URL=http://localhost:8000

# Shared secret for backend/ (ekko-ui + scripts/ekko_ui.py). Required; generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Put the same value in ekko-ui/.env.local as VITE_EKKO_API_TOKEN.
EKKO_API_TOKEN=

# Your home directory, e.g. C:\Users\yourname or /home/yourname. Optional --
# unset falls back to Path.home(). Set it so control_center/hands_on/file_gateway's
# policy.yaml can say "~/ekko-sandbox" instead of carrying a real username,
# and so the file gateway's roots don't move if something changes what the
# OS reports as home. Full path, not a username: that keeps the same value
# working on Windows, Linux and mac.
EKKO_HOME_DIR=

# Which model control_center/hands_on/file_gateway/llm_nl.py asks to parse a file request.
# One of:
#   ollama      local, nothing leaves the machine. The default, and the right
#               one here -- these prompts carry your own folder and file
#               names. Needs `ollama serve`; set EKKO_OLLAMA_MODEL to use
#               something other than qwen2.5:7b-instruct-q4_K_M.
#   gemini      the free cloud tier, fastest (~0.7s) and what the voice
#               fallback uses. Needs GEMINI_API_KEY above, and sends your
#               file names to Google. 15 requests/minute.
#   claude-cli  the `claude -p` CLI, same transport as llm_fallback/claude_code.
#               Needs a Claude subscription to authenticate and is far slower
#               (CLI cold start). Set EKKO_CLAUDE_MODEL to change the model.
EKKO_LLM=ollama
