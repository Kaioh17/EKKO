# Copy this file to .env (project root) and fill in your own keys.
# .env is gitignored -- real secrets never get committed.

# Gemini fallback LLM. Get a free key at https://aistudio.google.com/apikey
# -- no billing account required for the free tier.
GEMINI_API_KEY=

# Which scripts/<os>/ tree routing/host.py resolves handlers from:
# windows, linux, mac, or auto (detect via platform.system()). mac has no
# scripts/mac/ tree yet -- setting this to mac fails loudly at config load.
EKKO_OS=auto

# Where scripts/ekko_ui.py mirrors terminal report windows (daily_briefing,
# render_report) so ekko-ui can show them too. Defaults to the backend's
# usual local address; only set this if backend/main.py runs elsewhere.
EKKO_UI_URL=http://localhost:8000

# Shared secret for backend/ (ekko-ui + scripts/ekko_ui.py). Required; generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Put the same value in ekko-ui/.env.local as VITE_EKKO_API_TOKEN.
EKKO_API_TOKEN=
